{
  "name": "ephinea4haven",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/serve_site.mjs _site 5173",
    "build": "node scripts/build_site.mjs",
    "preview": "node scripts/serve_site.mjs _site 4173",
    "generate:angular": "node scripts/generate_angular_combo.mjs && node scripts/generate_angular_content.mjs",
    "generate:challenge-maps": "python3 scripts/build_challenge_map_atlas.py",
    "generate:challenge-maps:ep2": "python3 scripts/build_ep2_challenge_map_atlas.py",
    "sync:combo": "node scripts/sync_combo_calculator.mjs",
    "sync:i18n": "python3 scripts/sync_item_i18n.py",
    "sync:anniversary": "node scripts/sync_anniversary_milestones.mjs",
    "sync:rbr": "python3 scripts/build_rbr_data.py --require-current",
    "test:i18n": "python3 -m unittest scripts.test_sync_item_i18n",
    "test:anniversary-sync": "node --test scripts/test_sync_anniversary_milestones.mjs",
    "test:rbr": "python3 -m unittest scripts.test_build_rbr_data scripts.test_rbr_tiers scripts.test_rbr_tier_charts",
    "test": "npm run test:i18n && npm run test:anniversary-sync && npm run test:rbr && node scripts/verify_angular_architecture.mjs && node scripts/verify_challenge_maps.mjs && node scripts/verify_status_domain.mjs && node scripts/verify_mag_data.mjs && node scripts/verify_mag_sim_data.mjs && node scripts/verify_combo_sync.mjs",
    "test:e2e": "playwright test",
    "release:prepare": "npm test && npm run build && npm run test:e2e"
  },
  "overrides": {
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.30.0"
    },
    "@hono/node-server": "2.1.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/compiler-cli": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-server": "22.1.1",
    "@angular/router": "22.1.1",
    "@angular/ssr": "22.1.3",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "marked": "18.0.9",
    "parse5": "8.0.1",
    "rxjs": "7.8.2",
    "typescript": "6.0.3"
  }
}
